# The recompiler: a Flow (flow.zap) turned into one Zap function, a `match pc` over every code
# address, each arm the instruction's steps as Zap (emit.zap) ending in the next address, or a
# `return pc` where it hands back to the driver (a trap, a return, a dynamic jump, a call, or a
# branch out of the code found). The driver (run.zap) runs that one instruction and re-enters.

import cpu

# the control line that ends a simple arm: where pc goes next
fn controlLine(f Flow, i Inst, steps cpu.Step[]):
	next = i.at + i.length
	last = steps.last ?? return "\t\t\t\tpc = u32({next})"
	match last.op:
		Jump: "\t\t\t\tpc = u32({i.target})"
		JumpIf: "\t\t\t\tpc = u32({i.target}) if t[{last.a}] != 0 else u32({next})"
		_: "\t\t\t\tpc = u32({next})"

# whether the instruction's bytes hold one the program writes: code that changes, or data among
# the code, left to the interpreter
fn isWritten(i Inst, written i64[]):
	written.any(it >= i.at and it < i.at + i.length)

# the temporaries the arms use at most
fn mostTemporaries(f Flow, written i64[]):
	most = 0
	for at in f.order:
		i = f.code.get(at) ?? continue
		if f.isHandoff(i) or i.isWritten(written): continue
		steps, _ = i.lower(0)
		most = most.max(temporaryCount(steps))
	most

fn arm(f Flow, at i64, i Inst, written i64[]):
	if f.isHandoff(i) or i.isWritten(written): return ["\t\t\t{at}:", "\t\t\t\treturn u32({at})"]
	steps, _ = i.lower(0)
	lines = ["\t\t\t{at}:"]
	for s in steps:
		lines.extend(s.stepLines("\t\t\t\t"))
		# the exception is the driver's: it runs the instruction again, interpreted
		if s.op == .ExceptionIf: lines.push("\t\t\t\tif t[{s.a}] != 0: return u32({at})")
	lines.push(f.controlLine(i, steps))
	lines

# a run of bytes, [start, end)
pub type Span:
	start i64
	end i64

# the bytes the recompiled instructions span (not those the program writes), rising, neighbours
# joined
pub fn codeSpans(f Flow, written i64[]) Span[]:
	out Span[] = []
	for at in f.order:
		i = f.code.get(at) ?? continue
		if i.isWritten(written): continue
		end = at + i.length
		if not out.isEmpty and out[len - 1].end >= at:
			out[len - 1].end = out[len - 1].end.max(end)
		else:
			out.push(Span(start = at, end))
	out

# The module source of a function that runs the flow's code from `pc`, returning where it stops,
# the instructions over the bytes `written` (the program writes them) left to the interpreter;
# and of the bytes its instructions span (`{name}Code`): a write there makes it stale.
pub fn emitFunction(f Flow, name str, written i64[]) str:
	lines = [
		"# generated by projects/excel1/recomp.zap from the 68000 code: {f.code.len} instructions",
		"",
		"import cpu",
		"import m68k",
		"",
		"# runs the recompiled code from the offset start, the code at codeBase; returns the offset",
		"# where it hands back to the driver",
		"pub fn {name}(start u32, codeBase u32) u32:",
		"\tt = fill({f.mostTemporaries(written).max(1)}, u32(0))   # the steps' temporaries",
		"\tpc = start",
		"\twhile true:",
		"\t\tmatch i64(pc):"
	]
	for at in f.order:
		if f.code.get(at) is i:
			lines.extend(f.arm(at, i.copy(), written))
	lines.push("\t\t\t_: return pc")
	spans = f.codeSpans(written).map("m68k.Span(start = {.start}, end = {.end})").join(", ")
	lines.extend(["", "# the offsets its instructions span", "pub {name}Code = [{spans}]"])
	"{lines.join("\n")}\n"
