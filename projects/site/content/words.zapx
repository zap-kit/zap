		highlights = notesIn(false),
		speedChart = "Tempo e memória",
		timeChart = "Tempo",
		memoryChart = "Memória",
		tokensChart = "Tamanho do código",
		sourcesHtml = "Os problemas são inspirados no <a href=\"https://benchmarksgame-team.pages.debian.net/benchmarksgame/\">The Benchmarks Game</a>. Um mesmo agente de IA otimizou os programas de todas as linguagens com as mesmas regras: compara-se a linguagem, não quem programou.",
		tokensGuide = "Quanto código cada linguagem precisa para os mesmos programas, contado em palavras e símbolos: o Zap é 1,00x.",
		tie = "1,00x = empate",
		zapGuide = "1,00x = Zap",
		programs = programsPortuguese(),
		versus = "contra",
		discoverText = "Cole isto no seu agente de código para saber o que há de interessante na linguagem:",
		discoverPrompt = "Estude a linguagem Zap em https://github.com/zap-works/zap (o README e a pasta spec/) e me mostre, com exemplos curtos, o que ela faz diferente de C, Rust e Python.",
		sampleComments = {
			"# on every core at once: the strong ones, strongest": "# em todos os núcleos de uma vez: os fortes, os mais fortes",
			"# first, grouped by kind, and each kind's power": "# primeiro, agrupados por tipo, e o poder de cada tipo",
			"# memory checked when compiling, nothing written for it": "# memória verificada ao compilar, sem nada escrito para isso",
			"# error: cannot change 'team' while 'leader' borrows it": "# erro: não pode mudar 'team' enquanto 'leader' o empresta"
