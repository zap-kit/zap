		cta = "Descobrir",
		heroNote = "Windows e Linux, x64 e arm64; compila para Android. Experimental.",
		statLabels = ["mais rápido que o %lang, média de %count benchmarks", "menos memória que o %lang", "menos código que o %lang", "para o compilador compilar a si mesmo"],
		why = "Por que Zap",
		discoverHeading = "Descobrir a linguagem",
		copy = "Copiar",
		copied = "Copiado",
		built = "Feito com Zap",
