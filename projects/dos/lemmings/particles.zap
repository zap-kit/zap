# The explosion's particles as the DOS game draws them (Lemmix's table, read from the executable):
# 51 frames of 80 particles, each a signed (dx, dy) byte pair from the lemming's foot, -128 for no
# particle; the particle i of a frame is the colour of the palette entry particleColors[i % 16].
# long: the game's table

pub particleFrames = 51
pub particlesPerFrame = 80
pub particleColors = [4, 15, 14, 13, 12, 11, 10, 9, 8, 11, 10, 9, 8, 7, 6, 2]

rows = [
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	"",
	""]

fn signed(v i64):
	v - 256 if v >= 128 else v

# a particle's offset in `frame` (0..50): none when the frame has no such particle
pub fn particleAt(frame i64, i i64) (i64, i64)?:
	row = rows[frame]
	dx = signed(hexByte(row, i * 2))
	dy = signed(hexByte(row, i * 2 + 1))
	if dx == -128 or dy == -128: return none
	(dx, dy)

fn hexByte(row str, at i64):
	row[at * 2].hexValue() * 16 + row[at * 2 + 1].hexValue()
