{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ZapX",
  "scopeName": "source.zapx",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#fragment"
    },
    {
      "include": "#closing-tag"
    },
    {
      "include": "#opening-tag"
    },
    {
      "include": "#keyword"
    },
    {
      "include": "source.zap"
    }
  ],
  "repository": {
    "comment": {
      "match": "#.*$",
      "name": "comment.line.number-sign.zapx"
    },
    "closing-tag": {
      "match": "(</)([A-Za-z][\\w.]*)(>)",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.begin.zapx"
        },
        "2": {
          "patterns": [
            {
              "include": "#tag-name"
            }
          ]
        },
        "3": {
          "name": "punctuation.definition.tag.end.zapx"
        }
      }
    },
    "opening-tag": {
      "begin": "(<)([A-Za-z][\\w.]*)(?=[\\s/>])",
      "beginCaptures": {
        "1": {
          "name": "punctuation.definition.tag.begin.zapx"
        },
        "2": {
          "patterns": [
            {
              "include": "#tag-name"
            }
          ]
        }
      },
      "end": "(/?>)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.tag.end.zapx"
        }
      },
      "patterns": [
        {
          "match": "[A-Za-z_:][\\w:.-]*",
          "name": "entity.other.attribute-name.zapx"
        },
        {
          "match": "=",
          "name": "punctuation.separator.key-value.zapx"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.zapx"
        },
        {
          "include": "#expression"
        }
      ]
    },
    "tag-name": {
      "patterns": [
        {
          "match": "^[A-Z][\\w.]*$",
          "name": "support.class.component.zapx"
        },
        {
          "match": "^[a-z][\\w.-]*$",
          "name": "entity.name.tag.zapx"
        }
      ]
    },
    "expression": {
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.zapx"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.zapx"
        }
      },
      "contentName": "meta.embedded.zap",
      "patterns": [
        {
          "include": "#expression"
        },
        {
          "include": "#fragment"
        },
        {
          "include": "#closing-tag"
        },
        {
          "include": "#opening-tag"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "source.zap"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.function.zapx"
            },
            "2": {
              "name": "entity.name.function.zapx"
            }
          }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_]\\w*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.type.zapx"
            },
            "2": {
              "name": "entity.name.type.zapx"
            }
          }
        },
        {
          "match": "\\b(if|elif|else|for|in|while|loop|match|return|break|continue|try)\\b",
          "name": "keyword.control.zapx"
        },
        {
          "match": "\\b(import|from|as|pub|mut|move|ref|is|and|or|not|test|arena|use)\\b",
          "name": "keyword.other.zapx"
        },
        {
          "match": "\\b(true|false|none|it)\\b",
          "name": "constant.language.zapx"
        },
        {
          "match": "\\b(str|bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|n32|n64)\\b",
          "name": "support.type.primitive.zapx"
        },
        {
          "match": "\\b([A-Z]\\w*)\\b",
          "name": "entity.name.type.zapx"
        },
        {
          "match": "\\b([a-z_]\\w*)(?=\\()",
          "name": "entity.name.function.call.zapx"
        }
      ]
    },
    "fragment": {
      "match": "</?>",
      "name": "punctuation.definition.tag.fragment.zapx"
    }
  }
}